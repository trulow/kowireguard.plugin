# Rename to <name>.conf and import via Network -> kowireguard -> Import config...
# The filename without .conf is used only as a label; the interface name is
# set in Settings and defaults to wg0.
#
# WARNING: the private key below is stored in plain text. This device's
# storage synthesizes file permissions, so no file mode can protect it.
# Anyone with USB or filesystem access can read it. Use a dedicated peer
# you can revoke.

[Interface]
PrivateKey = REPLACE_WITH_YOUR_PRIVATE_KEY
Address = 10.7.0.2/32
DNS = 10.7.0.1
MTU = 1420

[Peer]
PublicKey = REPLACE_WITH_SERVER_PUBLIC_KEY
AllowedIPs = 0.0.0.0/0
Endpoint = vpn.example.com:51820
PersistentKeepalive = 25

